APP_NAME=ClusterMind AI API
APP_VERSION=0.1.0
API_PREFIX=/api/v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clustermind
POSTGRES_USER=clustermind
POSTGRES_PASSWORD=clustermind

LOG_LEVEL=INFO
MODEL_BUNDLE_PATH=data/models/model_bundle.joblib
EXPERIMENTS_PATH=data/experiments/runs.jsonl
METRICS_ENABLED=true


ANOMALY_BUNDLE_PATH=data/models/anomaly_bundle.joblib
SCHEDULER_ENABLED=true
